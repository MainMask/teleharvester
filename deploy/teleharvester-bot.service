[Unit]
Description=teleharvester control bot (aiogram host over Telethon workers)
After=network-online.target
Wants=network-online.target
# a config error (exit 1 at start) is restarted 5 times, then the unit stays failed
# instead of restarting every 5 s forever; `systemctl reset-failed` after fixing it
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
# --- edit these three for your install -------------------------------------
User=teleharvester
WorkingDirectory=/opt/teleharvester
ExecStart=/opt/teleharvester/.venv/bin/python -m bot
# ---------------------------------------------------------------------------
# Secrets (BOT_TOKEN, TG_API_ID, TG_API_HASH) are read from /opt/teleharvester/.env
# (the WorkingDirectory); admins come from config.toml [bot].

# survive crashes and transient failures over a multi-day run
Restart=on-failure
RestartSec=5
# aiogram turns SIGTERM into a graceful polling stop; give it room to finish
TimeoutStopSec=30
# a hung event loop (alive, but answering nothing) is not a crash: the bot pings this watchdog
# from its loop (bot/services/watchdog.py), and without a ping for 2 min systemd kills it and
# Restart= brings it back; only the bot's own process may ping, not the scraper's child
WatchdogSec=120
NotifyAccess=main

# logs go to journald (journalctl -u teleharvester-bot -f)
StandardOutput=journal
StandardError=journal
# unbuffered: the scraper's child process prints reach the journal at once, not lost on a kill
Environment=PYTHONUNBUFFERED=1
# a big mailing base is loaded in a worker thread (asyncio.to_thread); glibc gives each thread its
# own malloc arena, which keeps the freed memory resident afterwards: two arenas keep the peak down
Environment=MALLOC_ARENA_MAX=2

# hardening: the bot writes only under WorkingDirectory (sessions/, stats/, tmp/, output) and /tmp
# (a tdata import, now private to the unit and wiped on stop); it needs no privilege escalation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
