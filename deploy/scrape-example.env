# Copy to deploy/scrape-<name>.env and start with:
#   systemctl start teleharvester-scrape@<name>
# <name> becomes --name, so the output files are <name>_posts_... etc.
SCRAPE_ARGS=--channels @channel1,@channel2 --date-min 01.01.2024 --date-max 31.01.2024 --name example --out-dir /opt/teleharvester/data
