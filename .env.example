# Copy this file to .env and fill in your values. Secrets live here; behaviour
# settings (broadcast, limits, bot admins) live in config.toml.
# Used by the terminal menu and the control bot.
# api_id and api_hash are generated at https://my.telegram.org/apps

TG_API_ID=11111111
TG_API_HASH=0123456789abcdef0123456789abcdef

# Control bot token from @BotFather (python -m bot)
BOT_TOKEN=
