# Copy this file to .env and fill in your values.
# api_id and api_hash are generated at https://my.telegram.org/apps

TG_API_ID=11111111
TG_API_HASH=0123456789abcdef0123456789abcdef
# Optional: your phone in international format (e.g. +5511999999999), so the first
# login only asks for the code; leave empty to be prompted
TG_PHONE=
# Optional: your 2FA password, if the account has one
TG_PASSWORD=
# Optional: session as a string instead of the telescraper.session file.
# Get it with `telescraper login --string`. Full access to the account - keep it private.
TG_SESSION_STRING=
