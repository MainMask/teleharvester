[bot]
# Telegram control-panel bot (host). The token is a secret: set BOT_TOKEN in .env.
# admins = Telegram user IDs allowed to control the bot (whitelist).
admins = []

[broadcast]
messages = []
delay = [2, 5]
messages_count = 0   # per-chat cap for chat/comment campaigns; 0 = unlimited (send until stopped)
trigger = ""

[limits]
per_account_daily = 30
account_pause = [30, 60]
